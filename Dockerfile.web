# Mapping-webb (React/Vite) → byggs och serveras av nginx.
# Tom VITE_API_BASE_URL = relativa anrop på samma origin (mapping.kchd.se),
# nginx proxar API-prefixen vidare till mapping-api. Inga CORS-problem.
FROM node:20-alpine AS build
WORKDIR /app
COPY apps/web/ui/package*.json ./
RUN npm ci --no-audit --no-fund
COPY apps/web/ui/ ./
ENV VITE_API_BASE_URL=""
RUN npm run build

FROM nginx:1.27-alpine
COPY deploy/nginx.mapping.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
