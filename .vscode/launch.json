{
  "version": "0.2.0",
  "configurations": [
    // ── FastAPI backend ────────────────────────────────────────────────────
    {
      "name": "Debug: API (FastAPI :8000)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "apps.api.main:create_app",
        "--factory",
        "--host", "0.0.0.0",
        "--port", "8000",
        "--reload"
      ],
      "jinja": true,
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "python": "${command:python.interpreterPath}",
      "console": "integratedTerminal"
    },
    // ── pytest (all backend tests) ─────────────────────────────────────────
    {
      "name": "Debug: pytest (all API + packages)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v"],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "python": "${command:python.interpreterPath}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    // ── Chrome (Vite frontend) ─────────────────────────────────────────────
    {
      "name": "Debug: Web UI (Chrome :5173)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/apps/web/ui/src",
      "sourceMapPathOverrides": {
        "webpack:///./src/*": "${webRoot}/*"
      }
    }
  ],
  // ── Compound ──────────────────────────────────────────────────────────────
  "compounds": [
    {
      "name": "Debug: Full App (API + Chrome)",
      "configurations": [
        "Debug: API (FastAPI :8000)",
        "Debug: Web UI (Chrome :5173)"
      ],
      "stopAll": true,
      "preLaunchTask": "Dev: API"
    }
  ]
}
